HOST=127.0.0.1
PORT=3000
# Persistent writable directory, outside the public document root.
DATA_DIR=./data
# Set to the exact HTTPS origin before production traffic.
PUBLIC_ORIGIN=
# A real HTTPS scheduling URL. No fabricated dates are shown when it is empty.
CALENDAR_URL=
# Secret for a provider adapter signing booking confirmations (see README).
BOOKING_WEBHOOK_SECRET=
